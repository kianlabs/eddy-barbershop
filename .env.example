# =============================================================================
# Eddy Barbershop — contoh konfigurasi environment
# -----------------------------------------------------------------------------
# Salin file ini menjadi .env  (cp .env.example .env)  lalu isi nilainya.
# JANGAN commit .env. JANGAN pernah menaruh kredensial asli di file ini.
# =============================================================================

# --- Aplikasi ----------------------------------------------------------------
APP_NAME="Eddy Barbershop"
APP_ENV=local                 # local | production
APP_KEY=                      # wajib: hasil `php artisan key:generate`
APP_DEBUG=true                # production: false
APP_URL=http://localhost:8000 # ganti ke URL publik (mis. https://domain.tld) saat deploy

# --- Lokalisasi --------------------------------------------------------------
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- Maintenance mode --------------------------------------------------------
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Jumlah worker built-in server PHP saat melayani request (opsional).
# PHP_CLI_SERVER_WORKERS=4

# --- Hashing -----------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # production: warning (atau error)

# =============================================================================
# DATABASE — MySQL (WAJIB)
# -----------------------------------------------------------------------------
# Aplikasi ini memakai MySQL 8. Laravel juga menyediakan driver `sqlite`, TETAPI
# proyek ini TIDAK memakainya untuk runtime: file `database/database.sqlite`
# hanya sisa skeleton dan tidak dipakai. Jangan ubah DB_CONNECTION ke sqlite.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eddy_barber_booking
DB_USERNAME=eddy_barber
DB_PASSWORD=                  # isi password MySQL user di atas (kosongkan di file contoh)

# --- Session / Broadcast / Queue / Cache -------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail --------------------------------------------------------------------
# Default `log` = email ditulis ke storage/logs, aman untuk development.
# Untuk production, pakai smtp / mailgun / postmark / resend dan isi kredensial.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@eddybarber.test"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AKUN ADMIN PANEL (dipakai AdminSeeder)
# -----------------------------------------------------------------------------
# ADMIN_EMAIL: email login admin (fallback: admin@eddybarber.test).
# ADMIN_PASSWORD: WAJIB diisi di produksi. Bila kosong:
#   - produksi     -> seeder DITOLAK (tidak ada admin dibuat).
#   - non-produksi -> password acak digenerate & ditampilkan di output seeder.
# Jangan pernah commit password asli ke repository.
#   Login panel: /login  ->  /admin
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@eddybarber.test
ADMIN_PASSWORD=               # isi password admin yang kuat (min. 12 karakter)

# =============================================================================
# NOTIFIKASI BOOKING
# -----------------------------------------------------------------------------
# Alamat email tujuan notifikasi booking baru. Dipakai bila notifikasi email
# diaktifkan (lihat MAIL_* di atas). Kosongkan untuk menonaktifkan.
# Catatan: saat ini konfirmasi booking ke pelanggan dikirim lewat tautan
# WhatsApp `wa.me` di sisi klien (tanpa server/API), jadi BOOKING_NOTIFY_EMAIL
# bersifat opsional sampai fitur email/scheduler WA (H-1) diimplementasikan.
BOOKING_NOTIFY_EMAIL=

# =============================================================================
# WHATSAPP GATEWAY (OPSIONAL — belum diimplementasikan)
# -----------------------------------------------------------------------------
# Saat ini WhatsApp hanya berupa tautan wa.me (klik-untuk-chat), tanpa gateway.
# Bila nanti notifikasi otomatis H-1 ditambahkan (lihat PRD "Next"), isi salah
# satu penyedia di bawah. Biarkan komentar bila tidak dipakai.
# -----------------------------------------------------------------------------
# WA_GATEWAY=                       # baileys | fonnte | wablas | official
# WA_API_URL=
# WA_API_TOKEN=
# WA_SENDER_NUMBER=                 # nomor pengirim terdaftar (format 62...)

# --- AWS (opsional: S3 untuk upload foto kapster) ----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend (Vite) ---------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
